#!/bin/sh
# Bounded one-shot startup. No firmware installer or reboot command.
PATH=/bin:/sbin:/usr/bin:/usr/sbin
export PATH
n=0
while [ "$n" -lt 120 ]; do
 if [ -x /usr/local/bin/python ] && [ -f /etc/hal.conf ] && [ -f /tmp/em/em_0.info ]; then
  sleep 30
  exec /usr/local/bin/python /qts-profile/mods/reconcile.py
 fi
 sleep 5
 n=$((n + 1))
done
/sbin/notice_log_tool -a '[QTS Mods] Startup prerequisites unavailable after 10 minutes; all mods skipped. No firmware installation or reboot.' -t 4 -y 17 -G 0 -u System
exit 1
