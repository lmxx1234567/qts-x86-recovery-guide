#!/bin/sh
# Wait for native initialization and a stable live monitor before changing mappings.
PATH=/bin:/sbin:/usr/bin:/usr/sbin
export PATH
n=0
while [ "$n" -lt 120 ]; do
 if [ -x /usr/local/bin/python ] && /usr/local/bin/python /qts-profile/mods/reconcile.py --startup-ready; then
  sleep 30
  n=$((n + 6))
  if /usr/local/bin/python /qts-profile/mods/reconcile.py --startup-ready; then
   exec > /tmp/qts-mods-start.log 2>&1
   exec /usr/local/bin/python /qts-profile/mods/reconcile.py
  fi
 fi
 sleep 5
 n=$((n + 1))
done
/sbin/notice_log_tool -a '[QTS Mods] Native startup/monitor not ready; all mods skipped. No firmware installation or reboot.' -t 4 -y 17 -G 0 -u System
exit 1
